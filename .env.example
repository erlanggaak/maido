# Optional. Otherwise enter a key in Settings for this server session only.
# Never prefix secrets with VITE_.
MAIDO_PROVIDER=openai
MAIDO_MODEL=gpt-4.1-mini
MAIDO_API_KEY=
# Only used with MAIDO_PROVIDER=compatible. Include /v1 when required.
MAIDO_BASE_URL=
# Exact filename in models/. Used when no previous model choice is saved.
MAIDO_DEFAULT_MODEL=
# Local loopback only. Change if 4317 is occupied.
PORT=4317
